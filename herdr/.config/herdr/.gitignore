# Runtime state — regenerated by herdr, never track
*.log
*.sock
session.json
plugins.json

# Plugin runtime: track only our TOML config, not the downloaded/built plugin
plugins/*
!plugins/config/
plugins/config/*
!plugins/config/cloudmanic.herdr-plus/
plugins/config/cloudmanic.herdr-plus/*
!plugins/config/cloudmanic.herdr-plus/projects/
!plugins/config/cloudmanic.herdr-plus/quick-actions/
