theme = Poimandres
background-opacity = 0.88
background-blur-radius = 25
# background = #000000

font-family = JetBrainsMonoNL Nerd Font
font-size = 20
font-feature = -liga,-calt,-dlig
cursor-style = block
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background
unfocused-split-opacity = 0.55

macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = auto
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

auto-update = check
auto-update-channel = stable

# misc
shell-integration-features = no-cursor
copy-on-select = clipboard
progress-style = false

# shaders
# custom-shader = shaders/bloom025.glsl

# keybinds
keybind = super+,=text:ghostty +edit-config\n
# by default reload config with shft + cmd + ,

# split nav
keybind = super+alt+h=goto_split:left
keybind = super+alt+j=goto_split:bottom
keybind = super+alt+k=goto_split:top
keybind = super+alt+l=goto_split:right

# resize splits
keybind = super+shift+h=resize_split:left,20
keybind = super+shift+j=resize_split:down,20
keybind = super+shift+k=resize_split:up,20
keybind = super+shift+l=resize_split:right,20
keybind = super+shift+b=equalize_splits
keybind = super+shift+enter=toggle_split_zoom

