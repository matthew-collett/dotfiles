{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "OMC_SKIP_HOOKS": "keyword-detector"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(~/**/.claude/**)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(tree *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:*.readthedocs.io)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:*.k8s.io)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:clickhouse.com)",
      "WebFetch(domain:grpc.io)",
      "WebFetch(domain:protobuf.dev)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:nikitabobko.github.io)",
      "WebFetch(domain:felixkratz.github.io)",
      "WebFetch(domain:starship.rs)",
      "WebFetch(domain:neovim.io)",
      "WebFetch(domain:www.hammerspoon.org)",
      "WebFetch(domain:karabiner-elements.pqrs.org)",
      "WebFetch(domain:docs.atuin.sh)",
      "WebFetch(domain:docs.obsidian.md)",
      "WebFetch(domain:help.obsidian.md)",
      "WebFetch(domain:herdr.dev)",
      "Bash(grep *)",
      "Bash(egrep *)",
      "Bash(fgrep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(nl *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(comm *)",
      "Bash(column *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh repo view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh search *)",
      "Bash(gh label list *)",
      "Bash(gh auth status *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/id_rsa*)"
    ],
    "ask": [
      "Bash(run_in_background:true)",
      "Agent",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go run *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(jest *)",
      "Bash(make *)"
    ]
  },
  "model": "opus",
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "statusLine": {
    "type": "command",
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "skill-creator@claude-plugins-official": true
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": true,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "autoCompactEnabled": true,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "useAutoModeDuringPlan": false,
  "voiceEnabled": true,
  "magneticMode": true,
  "quietMode": true,
  "ignoreLocalFolderWarning": true,
  "messageIdleNotifThresholdMs": 0,
  "telemetryEnabled": false,
  "remoteControlNotifEnabled": true,
  "notificationVerbosity": "minimal",
  "workflowKeyboardTriggerEnabled": false,
  "omcHud": {
    "elements": {
      "cwd": true,
      "cwdFormat": "relative",
      "useHyperlinks": true,
      "gitBranch": true,
      "gitRepo": true,
      "gitStatus": true,
      "omcLabel": false,
      "rateLimits": true,
      "useBars": false,
      "updateNotification": false,
      "showCallCounts": false,
      "showTokens": true,
      "showSessionDuration": false,
      "thinking": false,
      "lastSkill": false,
      "profile": false,
      "promptTime": false
    }
  }
}
